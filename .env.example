# ==============================================================================
# EdgeLab - Environment Configuration Reference
# Copy this file to .env before running EdgeLab locally.
# ==============================================================================

# Port on the host for the frontend web application (Docker Compose)
FRONTEND_PORT=8080

# Image tag for Docker builds
EDGELAB_BACKEND_IMAGE=edgelab-backend:local

# Origins allowed to call the API services (CORS)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Public URL of the frontend application
EDGELAB_PUBLIC_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# Database Configuration
# Leave blank to use SQLite by default (recommended for local development).
# ------------------------------------------------------------------------------
DATABASE_URL=
EDGELAB_MARKET_DATA_DATABASE_URL=

# Optional performance Compose overlay: PostgreSQL for application data,
# TimescaleDB for candle data, Redis for shared cache/rate limits, and PgBouncer
# for connection pooling. Start it with the command documented in README.md.
POSTGRES_DB=edgelab
POSTGRES_USER=edgelab
POSTGRES_PASSWORD=edgelab
EDGELAB_POSTGRES_HOST=localhost
EDGELAB_POSTGRES_CONNECT_PORT=5432
EDGELAB_POSTGRES_PORT=5432
EDGELAB_MARKET_DATA_POSTGRES_HOST=localhost
EDGELAB_MARKET_DATA_POSTGRES_PORT=5433
EDGELAB_TIMESCALE_PORT=5433
EDGELAB_PGBOUNCER_POSTGRES_PORT=6432
EDGELAB_PGBOUNCER_TIMESCALE_PORT=6433
EDGELAB_PGBOUNCER_MAX_CLIENT_CONN=400
EDGELAB_PGBOUNCER_DEFAULT_POOL_SIZE=25
EDGELAB_PGBOUNCER_RESERVE_POOL_SIZE=5
EDGELAB_REDIS_URL=
EDGELAB_REDIS_PORT=6379
EDGELAB_REDIS_MAXMEMORY=256mb

# Connection pool sizing
EDGELAB_DB_POOL_SIZE=5
EDGELAB_DB_POOL_MAX_OVERFLOW=10
EDGELAB_DB_POOL_TIMEOUT_SECONDS=5
EDGELAB_RUN_MIGRATIONS=1

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
EDGELAB_ENVIRONMENT=development
EDGELAB_DEPLOYMENT_MODE=development

# JWT Secret for signing local access tokens (change for real deployments)
EDGELAB_JWT_SECRET=local-development-secret-key-change-in-production

# Enable local developer authentication bypass without external identity provider
EDGELAB_DEV_AUTH_BYPASS=1

# Better Auth configuration
EDGELAB_AUTH_PROVIDER=better-auth
EDGELAB_BETTER_AUTH_INTERNAL_URL=http://auth:3002
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=local-better-auth-signing-secret-change-me
EDGELAB_AUTH_SERVICE_KEY=local-better-auth-service-key-change-me

# Optional: Google OAuth (leave empty to use local dev sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS_FILE=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback/google

# ------------------------------------------------------------------------------
# Market Data & Datasets
# ------------------------------------------------------------------------------
# Path to directory containing market CSV datasets
EDGELAB_DATASETS_ROOT=./datasets
EDGELAB_DATASET_AUTO_DISCOVERY_ENABLED=1
EDGELAB_CACHE_MARKET_DATA=1
EDGELAB_MARKET_DATA_IMPORT_ENABLED=0

# Rate limiting for expensive endpoints
EDGELAB_RATE_LIMIT_WINDOW_SECONDS=60
EDGELAB_DATASET_REFRESH_RATE_LIMIT=10
EDGELAB_MARKET_DATA_META_RATE_LIMIT=240
EDGELAB_MARKET_DATA_BARS_RATE_LIMIT=240

# Maximum request body size in bytes (25MB default)
EDGELAB_MAX_REQUEST_BODY_BYTES=26214400
EDGELAB_MAX_APP_DATA_ROWS=100000

# ------------------------------------------------------------------------------
# Frontend Build Configuration (VITE_*)
# Note: Values starting with VITE_ are embedded into public browser bundles.
# Never place secret keys in VITE_* variables.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_API_BEARER_TOKEN=
VITE_DEPLOYMENT_MODE=development

# ------------------------------------------------------------------------------
# Optional AI Assistant / Quant Workspace (OpenAI-compatible API)
# ------------------------------------------------------------------------------
EDGELAB_EXTERNAL_AI_BASE_URL=
EDGELAB_EXTERNAL_AI_MODEL=
EDGELAB_EXTERNAL_AI_TIMEOUT_SECONDS=30
