# Copy to .env before running Docker Compose when local paths differ.

# Host port used by the frontend/Nginx container.
FRONTEND_PORT=8080

# Origins allowed to call the FastAPI service. Keep these aligned with FRONTEND_PORT.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional full database URL override. Leave blank to use the PostgreSQL defaults below.
DATABASE_URL=

# Default PostgreSQL container settings for the bundled single-VM Docker Compose stack.
POSTGRES_DB=edgelab
POSTGRES_USER=edgelab
POSTGRES_PASSWORD=edgelab
EDGELAB_POSTGRES_HOST=postgres
EDGELAB_POSTGRES_CONNECT_PORT=5432
EDGELAB_POSTGRES_PORT=5432

# Optional benchmark-profile infrastructure ports.
EDGELAB_REDIS_PORT=6379
EDGELAB_TIMESCALE_PORT=5433
EDGELAB_MINIO_PORT=9000
EDGELAB_MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=edgelabminio
MINIO_ROOT_PASSWORD=edgelabminio

# Optional bearer token required by protected API routes when set.
EDGELAB_API_TOKEN=

# Optional Gunicorn overrides for the FastAPI container. Leave EDGELAB_API_WORKERS blank to auto-size at 2 workers per vCPU with a floor of 2.
EDGELAB_API_WORKERS=
EDGELAB_API_TIMEOUT_SECONDS=120
EDGELAB_API_GRACEFUL_TIMEOUT_SECONDS=30
EDGELAB_API_KEEPALIVE_SECONDS=5

# Required secret used to sign beta session JWTs for authenticated workspace access.
EDGELAB_JWT_SECRET=change-me

# Google OAuth credentials for real sign-in flow.
# Prefer GOOGLE_CLIENT_SECRETS_FILE in Docker/Jenkins so frontend can fetch client ID at runtime.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS_FILE=/opt/edgelab/deployment/google-oauth-client.json
GOOGLE_REDIRECT_URI=https://edgelab.publicvm.com/auth/callback/google
EDGELAB_PUBLIC_ORIGIN=https://edgelab.publicvm.com

# Maximum HTTP request body size accepted by FastAPI, in bytes.
EDGELAB_MAX_REQUEST_BODY_BYTES=26214400

# Maximum total rows allowed in app-data imports and exports.
EDGELAB_MAX_APP_DATA_ROWS=100000

# Short-lived in-process read-model caches for the initial shell/bootstrap and dataset catalog.
EDGELAB_BOOTSTRAP_SHELL_CACHE_TTL_SECONDS=3
EDGELAB_DATASET_CATALOG_CACHE_TTL_SECONDS=5

# Analytics worker refresh cadence for session summary read models.
EDGELAB_ANALYTICS_INTERVAL_SECONDS=60

# API base URL compiled into the frontend bundle.
VITE_API_BASE_URL=/api

# Optional bearer token sent by the frontend. Keep equal to EDGELAB_API_TOKEN when API auth is enabled.
VITE_API_BEARER_TOKEN=

# EdgeLab deployment mode rendered by the landing/pricing pages.
# beta    -> single free Beta card with a live seat counter (default).
# production -> three-tier Starter / Pro / Trader+ pricing.
VITE_DEPLOYMENT_MODE=beta

# Backend-enforced beta seat cap used by auth + waitlist APIs.
EDGELAB_BETA_SEATS_TOTAL=500
EDGELAB_BETA_MANUAL_ACCESS_ENABLED=0

# Beta seat counter shown on the landing + pricing pages in beta mode.
# Keep `VITE_BETA_SEATS_TOTAL` aligned with `EDGELAB_BETA_SEATS_TOTAL` for fallback UI.
VITE_BETA_SEATS_TOTAL=500
VITE_BETA_SEATS_TAKEN=0

# npm registry used while building the frontend Docker image.
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# Host path to the folder of dataset subdirectories scanned by the app.
# The default ./datasets folder is tracked with .gitkeep; generated data stays ignored.
EDGELAB_DATASETS_ROOT=./datasets

# Scheduled minute-data populator settings. It writes M1 CSVs under EDGELAB_DATASETS_ROOT.
# Defaults to root so Docker can create folders in host bind mounts; set to UID:GID if preferred.
EDGELAB_DATA_POPULATOR_USER=0:0
EDGELAB_DATA_POPULATOR_INTERVAL_SECONDS=3600
EDGELAB_DATA_POPULATOR_BACKFILL_MODE=max
EDGELAB_DATA_POPULATOR_LOOKBACK_DAYS=30
EDGELAB_DATA_POPULATOR_DERIVED_TIMEFRAMES=M5,M15,M30,H1,H4,Daily
EDGELAB_DATA_POPULATOR_REQUEST_TIMEOUT_SECONDS=20
EDGELAB_DATA_POPULATOR_FOREX_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,USD/CAD,NZD/USD
EDGELAB_DATA_POPULATOR_FOREX_START_DATE=2003-01-01
EDGELAB_DATA_POPULATOR_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT
EDGELAB_DATA_POPULATOR_CRYPTO_START_DATE=2017-08-17

# Optional legacy single-file replay path. Docker Compose defaults to dataset-root mode.
# EDGELAB_CSV_PATH=/absolute/path/to/EURUSD_M1.csv

# Set to 0 to disable backend in-memory market data caching.
EDGELAB_CACHE_MARKET_DATA=1

# Host port for the optional legacy Node API profile.
LEGACY_API_PORT=3001

# Optional legacy Node API hardening settings.
LEGACY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
LEGACY_API_MAX_BODY_BYTES=10485760
