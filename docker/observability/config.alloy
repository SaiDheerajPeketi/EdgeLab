// Collect only this Compose project's application services. Do not promote
// request IDs, trace IDs, URL paths, or arbitrary Docker labels to Loki labels.
logging {
  level = "warn"
  format = "json"
}

discovery.docker "apps" {
  host = "http://docker-log-proxy:2375"
  refresh_interval = "15s"
  filter {
    name = "label"
    values = ["com.docker.compose.project=" + sys.env("EDGELAB_LOG_COMPOSE_PROJECT")]
  }
}

discovery.relabel "apps" {
  targets = discovery.docker.apps.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "api|market-api|auth|frontend|data-populator|analytics-worker|legacy-api"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "compose_service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "compose_project"
  }
}

loki.source.docker "apps" {
  host = "http://docker-log-proxy:2375"
  targets = discovery.relabel.apps.output
  labels = {}
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  max_streams = 2000
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    batch_size = "1MiB"
    batch_wait = "1s"
    remote_timeout = "5s"
    max_backoff_period = "10s"
    max_backoff_retries = 5
  }
}
