# Exclude query strings, addresses and referrers (OAuth codes and tenant identifiers).
log_format edgelab_access escape=json '{"timestamp":"$time_iso8601","level":"INFO",'
  '"method":"$request_method","status":$status,"duration":$request_time,'
  '"upstream_status":"$upstream_status","upstream_duration":"$upstream_response_time"}';
access_log /var/log/nginx/access.log edgelab_access;
# Nginx error records can include full OAuth callback URLs on proxy failure.
# Structured status/upstream timing above retains failure evidence without codes.
error_log /var/log/nginx/error.log crit;

# Socket clients share a budget; forwarded address headers are not trusted keys.
limit_req_zone $binary_remote_addr zone=google_exchange:10m rate=10r/m;

# Keep Retry-After at server scope so error locations inherit every security header.
map $limit_req_status $google_exchange_retry_after {
  default "";
  REJECTED "6";
}

# API responses, including proxy errors, must never enter shared CDN caches.
map $uri $private_api_cache_control {
  default "";
  ~^/api(?:/|$) "private, no-store";
}

upstream edgelab_api {
  server api:8000;
  keepalive 32;
}

map $http_upgrade $personal_connection {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 25m;
  sendfile on;
  tcp_nopush on;

  open_file_cache max=1000 inactive=30s;
  open_file_cache_valid 60s;
  open_file_cache_min_uses 2;
  open_file_cache_errors on;

  gzip on;
  gzip_static on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_vary on;
  gzip_types
    application/javascript
    application/json
    application/manifest+json
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;

  add_header Retry-After $google_exchange_retry_after always;
  add_header Cache-Control $private_api_cache_control always;
  add_header CDN-Cache-Control $private_api_cache_control always;
  add_header Cloudflare-CDN-Cache-Control $private_api_cache_control always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://data-api.binance.vision https://api.binance.com https://freeserv.dukascopy.com wss://data-stream.binance.vision ws://localhost:* ws://127.0.0.1:*;" always;

  location = /nginx-health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /api/observability/metrics { return 404; }
  location /api/better-auth/ { return 404; }

  location /api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite any caller-provided value. This key never enters the browser bundle.
    proxy_set_header X-EdgeLab-Personal-Key "${EDGELAB_PERSONAL_PROXY_SECRET}";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $personal_connection;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_pass http://edgelab_api;
  }

  location ^~ /source/ {
    expires -1;
    try_files $uri $uri/ =404;
  }
  location /assets/ {
    access_log off;
    expires 1y;
    try_files $uri =404;
  }
  location = /index.html {
    expires -1;
    try_files /index.html =404;
  }
  location / {
    expires -1;
    try_files $uri $uri/ /index.html;
  }
}
