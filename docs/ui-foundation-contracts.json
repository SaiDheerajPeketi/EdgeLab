{
  "schemaVersion": 1,
  "routes": {
    "/": { "source": "frontend/src/pages/LandingPage.tsx", "restoration": "not-applicable" },
    "/index.html": { "source": "frontend/src/routes/AppRoutes.tsx", "restoration": "redirect" },
    "/pricing": { "source": "frontend/src/pages/PricingPage.tsx", "restoration": "not-applicable" },
    "/privacy": { "source": "frontend/src/pages/LegalPages.tsx", "restoration": "not-applicable" },
    "/terms": { "source": "frontend/src/pages/LegalPages.tsx", "restoration": "not-applicable" },
    "/auth/signin": { "source": "frontend/src/pages/AuthSignInPage.tsx", "restoration": "return-url" },
    "/auth/callback/google": { "source": "frontend/src/pages/AuthCallbackPage.tsx", "restoration": "return-url" },
    "/shared": { "source": "frontend/src/pages/SharedWorkspacePage.tsx", "restoration": "share-token" },
    "/workspace": { "source": "frontend/src/routes/AppRoutes.tsx", "restoration": "redirect" },
    "*": { "source": "frontend/src/App.tsx", "restoration": "not-applicable" },
    "/app": { "source": "frontend/src/components/SessionGateway.tsx", "restoration": "navigation-state" },
    "/app/*": { "source": "frontend/src/routes/AppRoutes.tsx", "restoration": "route-resolution" },
    "/app/live": { "source": "frontend/src/App.tsx", "restoration": "chart-workspace" },
    "/app/replay": { "source": "frontend/src/App.tsx", "restoration": "chart-workspace" },
    "/app/order-flow": { "source": "frontend/src/components/EdgeLabWorkspace.tsx", "restoration": "chart-workspace" },
    "/app/journal": { "source": "frontend/src/components/journal/JournalDashboard.tsx", "restoration": "navigation-state" },
    "/app/journal/dashboard": { "source": "frontend/src/components/journal/JournalDashboard.tsx", "restoration": "navigation-state" },
    "/app/journal/accounts": { "source": "frontend/src/components/journal/JournalAccountsSurface.tsx", "restoration": "journal-workspace" },
    "/app/journal/trades": { "source": "frontend/src/components/journal/JournalTradesSurface.tsx", "restoration": "navigation-state" },
    "/app/journal/analytics": { "source": "frontend/src/components/journal/JournalAnalyticsSurface.tsx", "restoration": "journal-workspace" },
    "/app/journal/calendar": { "source": "frontend/src/components/journal/JournalDashboard.tsx", "restoration": "navigation-state" },
    "/app/journal/notes": { "source": "frontend/src/components/journal/JournalNotesSurface.tsx", "restoration": "journal-workspace" },
    "/app/journal/reports": { "source": "frontend/src/components/journal/JournalAnalyticsSurface.tsx", "restoration": "journal-workspace" },
    "/app/journal/settings": { "source": "frontend/src/components/settings/SettingsCenter.tsx", "restoration": "settings-preferences" },
    "/app/reports": { "source": "frontend/src/components/ResultsPanel.tsx", "restoration": "navigation-state" },
    "/app/quant": { "source": "frontend/src/components/QuantPanel.tsx", "restoration": "panel-preferences" },
    "/app/settings": { "source": "frontend/src/components/settings/SettingsCenter.tsx", "restoration": "settings-preferences" },
    "/app/settings/:category": { "source": "frontend/src/components/settings/SettingsCenter.tsx", "restoration": "settings-preferences" }
  },
  "panels": {
    "Journal": ["frontend/src/components/journal/JournalPanelManager.tsx"],
    "Watchlist": ["frontend/src/components/EdgeLabWorkspace.tsx"],
    "Quant assistant": ["frontend/src/components/QuantPanel.tsx"],
    "Data Window": ["frontend/src/components/journal/JournalPanelManager.tsx", "frontend/src/components/TradingChart.tsx"],
    "Objects": ["frontend/src/components/ChartObjectsPanel.tsx"],
    "Indicator editor": ["frontend/src/components/IndicatorEditorPanel.tsx"],
    "Order Book": ["frontend/src/components/chart/MarketToolsPanels.tsx"],
    "Alerts": ["frontend/src/components/chart/MarketToolsPanels.tsx"],
    "Order ticket": ["frontend/src/components/OrderTicket.tsx"],
    "Replay transport": ["frontend/src/components/ReplayController.tsx"]
  },
  "overlays": {
    "command palette": ["frontend/src/components/GlobalCommandPalette.tsx"],
    "shortcut catalog": ["frontend/src/components/GlobalCommandPalette.tsx", "frontend/src/components/AccountSystemMenu.tsx"],
    "account menu": ["frontend/src/components/AccountSystemMenu.tsx"],
    "mobile navigation": ["frontend/src/components/WorkspaceMobileNav.tsx"],
    "trade review drawer": ["frontend/src/components/journal/JournalReviewDrawer.tsx"],
    "add trade flow": ["frontend/src/components/JournalEntryModal.tsx"],
    "journal import flow": ["frontend/src/components/EdgeLabWorkspace.tsx"],
    "broker connection flow": ["frontend/src/components/settings/SettingsIntegrations.tsx"],
    "workspace sharing": ["frontend/src/components/WorkspaceShareDialog.tsx"],
    "chart settings": ["frontend/src/components/ChartToolbar.tsx"],
    "indicator settings": ["frontend/src/components/IndicatorEditorPanel.tsx", "frontend/src/components/ChartObjectsPanel.tsx"],
    "drawing settings": ["frontend/src/components/TradingChart.tsx"],
    "symbol search": ["frontend/src/components/ChartToolbar.tsx"],
    "radial drawing toolbox": ["frontend/src/components/TradingChart.tsx"],
    "confirmation dialog": ["frontend/src/components/ui/Primitives.tsx"],
    "toast": ["frontend/src/components/ui/Primitives.tsx"]
  },
  "sharedContracts": {
    "icons": "frontend/src/components/ui/Primitives.tsx",
    "language": "frontend/src/lib/productLanguage.ts",
    "overlays": "frontend/src/components/overlays/OverlaySurface.tsx",
    "modalOverlays": "frontend/src/components/ui/Primitives.tsx",
    "panels": "frontend/src/components/ui/WorkspacePanelManager.tsx",
    "restoration": "frontend/src/lib/navigationState.ts",
    "tokens": "frontend/src/styles.css"
  }
}
