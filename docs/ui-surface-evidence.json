  "assertions": {
    "landmarks": { "source": "e2e/protected-workspace.quality.spec.ts", "patterns": ["axe.run", "landmarks"] },
    "heading-order": { "source": "e2e/public-auth.visual.spec.ts", "patterns": ["getByRole(\"heading\"", "level: surface.level"] },
    "accessible-names": { "source": "e2e/accessibility-release.spec.ts", "patterns": ["axe.run", "serious axe or contrast violations"] },
    "keyboard-complete": { "source": "e2e/shared-controls.accessibility.spec.ts", "patterns": ["page.keyboard.press", "stable accessible name"] },
    "focus-return": { "source": "e2e/protected-workspace.quality.spec.ts", "patterns": ["restore keyboard focus", "toBeFocused"] },
    "escape-dismissal": { "source": "e2e/navigation.interaction.spec.ts", "patterns": ["page.keyboard.press(\"Escape\")", "restores the trigger"] },
    "textual-chart-summary": { "source": "e2e/accessibility-release.spec.ts", "patterns": ["Latest bar|No bars are currently available"] },
    "contrast-aa": { "source": "e2e/accessibility-release.spec.ts", "patterns": ["color-contrast", "axe.run"] },
    "color-redundancy": { "source": "e2e/protected-workspace.quality.spec.ts", "patterns": ["financial meaning survives", "LONG|SHORT|Winner|Loser"] },
    "color-vision-simulation": { "source": "e2e/protected-workspace.quality.spec.ts", "patterns": ["protanopia", "deuteranopia", "tritanopia"] },
    "reduced-motion": { "source": "e2e/motion-preference.interaction.spec.ts", "patterns": ["reduced-motion preference", "reducedMotion: \"reduce\""] },
    "compositor-only-repeated-motion": { "source": "e2e/motion-preference.interaction.spec.ts", "patterns": ["Performance.getMetrics", "LayoutCount"] },
    "no-horizontal-overflow": { "source": "e2e/protected-workspace.quality.spec.ts", "patterns": ["scrollWidth", "innerWidth"] },
    "zoom-200": { "source": "e2e/protected-workspace.quality.spec.ts", "project": "mobile", "patterns": ["Emulation.setPageScaleFactor", "pageScaleFactor: 2"] },
    "coarse-pointer": { "source": "e2e/protected-workspace.quality.spec.ts", "project": "mobile", "patterns": ["(pointer: coarse)", "toBe(true)"] },
    "safe-area": { "source": "frontend/src/components/WorkspaceMobileNav.tsx", "patterns": ["env(safe-area-inset-bottom)"] },
    "rtl": { "source": "e2e/protected-workspace.quality.spec.ts", "project": "mobile", "patterns": ["document.documentElement.dir = \"rtl\""] },
    "long-content": { "source": "e2e/protected-workspace.quality.spec.ts", "project": "mobile", "patterns": ["edgelab.ui-test.long-label"] },
    "touch-targets": { "source": "e2e/protected-workspace.quality.spec.ts", "project": "mobile", "patterns": ["target.width < 44", "target.height < 44"] },
    "raw-route-chunk-budget": { "source": "scripts/check-ui-performance.mjs", "patterns": ["budget.rawBytes.routeChunk", "UI performance budget exceeded"] },
    "sixteen-pane-interaction-budget": { "source": "e2e/chart-performance.spec.ts", "project": "low-power", "patterns": ["sixteenPaneFrameP95Ms", "sixteenPaneResizeStressP95Ms"] },
    "performance-budget": { "source": "scripts/check-ui-performance.mjs", "patterns": ["ui-performance-budgets.json", "failures.length"] },
    "server-rollout-fallback": { "source": "e2e/protected-workspace.quality.spec.ts", "project": "desktop", "patterns": ["server kill switch", "data-ui-version"] }
  },
  "assertionGaps": {
    "safe-area": "CSS safe-area consumption is present, but no browser test currently emulates a non-zero safe-area inset."
  }
}
