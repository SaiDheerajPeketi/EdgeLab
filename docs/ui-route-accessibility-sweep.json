{
  "schemaVersion": 1,
  "viewports": ["mobile", "tablet", "desktop"],
  "routes": {
    "/": { "mode": "test", "path": "/" },
    "/index.html": { "mode": "exempt", "kind": "alias", "target": "/", "reason": "Static-host alias of the landing route." },
    "/pricing": { "mode": "test", "path": "/pricing" },
    "/privacy": { "mode": "test", "path": "/privacy" },
    "/terms": { "mode": "test", "path": "/terms" },
    "/auth/signin": { "mode": "test", "path": "/auth/signin" },
    "/auth/callback/google": { "mode": "exempt", "kind": "boundary", "target": "/auth/signin", "reason": "OAuth callback requires a provider-issued code and state." },
    "/shared": { "mode": "exempt", "kind": "boundary", "target": "/shared?token=provider-issued", "reason": "Shared workspace requires a provider-issued share token; token states have dedicated evidence." },
    "/workspace": { "mode": "exempt", "kind": "alias", "target": "/app", "reason": "Legacy compatibility alias for the authenticated workspace." },
    "*": { "mode": "exempt", "kind": "boundary", "target": "/not-a-route", "reason": "Router not-found boundary is exercised through an unknown concrete path." },
    "/app": { "mode": "test", "path": "/app" },
    "/app/*": { "mode": "exempt", "kind": "boundary", "target": "/app/live", "reason": "Wildcard ownership boundary; concrete child routes are swept individually." },
    "/app/live": { "mode": "test", "path": "/app/live" },
    "/app/replay": { "mode": "test", "path": "/app/replay" },
    "/app/order-flow": { "mode": "test", "path": "/app/order-flow" },
    "/app/journal": { "mode": "exempt", "kind": "alias", "target": "/app/journal/dashboard", "reason": "Journal root resolves to the dashboard view." },
    "/app/journal/dashboard": { "mode": "test", "path": "/app/journal/dashboard" },
    "/app/journal/accounts": { "mode": "test", "path": "/app/journal/accounts" },
    "/app/journal/trades": { "mode": "test", "path": "/app/journal/trades" },
    "/app/journal/analytics": { "mode": "test", "path": "/app/journal/analytics" },
    "/app/journal/notes": { "mode": "test", "path": "/app/journal/notes" },
    "/app/journal/calendar": { "mode": "test", "path": "/app/journal/calendar" },
    "/app/journal/reports": { "mode": "test", "path": "/app/journal/reports" },
    "/app/journal/settings": { "mode": "test", "path": "/app/journal/settings" },
    "/app/reports": { "mode": "test", "path": "/app/reports" },
    "/app/quant": { "mode": "test", "path": "/app/quant" },
    "/app/settings": { "mode": "exempt", "kind": "alias", "target": "/app/settings/global", "reason": "Settings root resolves to the default global category." },
    "/app/settings/:category": { "mode": "test", "path": "/app/settings/global" }
  }
}
