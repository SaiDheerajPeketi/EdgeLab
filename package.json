{
  "name": "edgelab-root",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node backend/index.js",
    "dev:python": "PYTHONPATH=backend backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev -- --port 5173",
    "export:screens": "node scripts/export-app-screens.mjs",
    "start:backend": "node backend/index.js",
    "build": "npm --prefix frontend run build",
    "check:ui-inventory": "node scripts/check-ui-surface-inventory.mjs",
    "check:ui-motion": "node scripts/check-ui-motion.mjs",
    "check:ui-performance": "node scripts/check-ui-performance.mjs",
    "check:ui-release": "node scripts/check-ui-release.mjs",
    "quality:ui": "npm run check:ui-release && npm run check:ui-inventory -- --require-complete && npm run check:ui-performance && npm run check:ui-motion",
    "test": "node --test \"backend/tests/*.test.js\"",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:report": "playwright show-report .artifacts/ui-report",
    "bench:seed": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/seed_benchmark_data.py",
    "bench:load": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/load_test_services.py",
    "bench:bootstrap-profiles": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/benchmark_bootstrap_profiles.py",
    "bench:session-summaries": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/benchmark_session_summaries.py",
    "bench:metrics-profiles": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/benchmark_metrics_profiles.py",
    "bench:market-data-storage": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/benchmark_market_data_storage.py",
    "bench:e2e-capacity": "bash benchmark/run-capacity-sweep.sh",
    "market-data:import": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/import_market_data_to_db.py",
    "analytics:refresh-session-summaries": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/refresh_session_summaries.py",
    "analytics:refresh-read-models": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/refresh_session_summaries.py"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "axe-core": "^4.10.3",
    "dom-to-svg": "^0.12.2",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.55.0"
  }
}
