{
  "name": "tradezella-clone-root",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node backend/index.js",
    "dev:frontend": "npm --prefix frontend run dev -- --port 5173",
    "start:backend": "node backend/index.js",
    "build": "npm --prefix frontend run build",
    "test": "node --test \"backend/tests/*.test.js\""
  }
}
