// EdgeLab v2 compatibility migration (2026-10-08): Pine v4 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/volume/price_volume_trend.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Price Volume Trend", shorttitle="PVT", format=format.volume)

// Legacy transp preserves colors that already contain transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

showSignal = input.bool(title="Show Signal ?", defval=true)
signalType = input.string(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Smoothing Length", defval=21)
src = input.source(title="Source", defval=close)
highlightCrossovers = input.bool(title="Highlight Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)

signal = signalType == "EMA" ? ta.ema(ta.pvt, signalLength) : ta.sma(ta.pvt, signalLength)

trendColor = ta.pvt > signal ? #0ebb23 : #FF5252
pvtColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

pvtPlot = plot(ta.pvt, title="PVT", linewidth=2, color=pvtColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color.new(#FFFFFF, 100)

fillColor = applyFilling ? trendColor : transparent
fill(pvtPlot, signalPlot, color=_legacyTransparency(fillColor, 70))

buyAlert = ta.crossover(ta.pvt, signal)
sellAlert = ta.crossunder(ta.pvt, signal)

plotshape(buyAlert and highlightCrossovers ? ta.pvt : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=#4CAF50)
plotshape(sellAlert and highlightCrossovers ? ta.pvt : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=#FF5252)

alertcondition(buyAlert, title="Alert: Buy", message="Buy\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
alertcondition(sellAlert, title="Alert: Sell", message="Sell\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
