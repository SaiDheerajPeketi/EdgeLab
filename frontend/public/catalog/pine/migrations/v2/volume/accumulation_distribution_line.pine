// EdgeLab v2 compatibility migration (2026-10-08): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/volume/accumulation_distribution_line.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Accumulation/Distribution Line", shorttitle="Accum/Dist", precision=0)

// Legacy transp preserves colors that already contain transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

showSignal = input.bool(title="Show Signal ?", defval=true)
signalType = input.string(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Smoothing Length", defval=21)
highlightCrossovers = input.bool(title="Highlight Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)

signal = signalType == "EMA" ? ta.ema(ta.accdist, signalLength) : ta.sma(ta.accdist, signalLength)

trendColor = ta.accdist > signal ? #0ebb23 : #FF5252

adColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

adPlot = plot(ta.accdist, title="Accum/Dist", linewidth=2, color=adColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color.new(#FFFFFF, 100)

fillColor = applyFilling ? trendColor : transparent
fill(adPlot, signalPlot, color=_legacyTransparency(fillColor, 70))

plotshape(ta.crossover(ta.accdist, signal) and highlightCrossovers ? ta.accdist : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=#4CAF50)
plotshape(ta.crossunder(ta.accdist, signal) and highlightCrossovers ? ta.accdist : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=#FF5252)
