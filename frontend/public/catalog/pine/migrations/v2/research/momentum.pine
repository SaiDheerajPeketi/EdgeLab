indicator("Momentum")

// Legacy transp preserves colors that already contain transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

src = close
length = 7

mom = src - src[length]

mom2 = ta.change(src, length)

mom3 = ta.mom(src, length)

sma = ta.sma(src, length)
mom4 = (sma - sma[1]) * length

plot(mom, title="Simple", color=#2196F3)
plot(mom2, title="2", color=#4CAF50)
plot(mom3, title="3", color=#FF5252)
plot(mom4, title="4", color=#9C27B0)
