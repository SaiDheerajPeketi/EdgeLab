// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/oscillators/coppock_curve.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Coppock Curve")

// Legacy transp preserves colors that already contain transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

length = input.int(title="Smoothing Length", defval=10)
longRocLength = input.int(title="Long ROC Length", defval=14)
shortRocLength = input.int(title="Short ROC Length", defval=11)
src = input.source(title="Source", defval=close)

coppock = ta.wma(ta.roc(src, longRocLength) + ta.roc(src, shortRocLength), length)

coppockColor = coppock > 0 ? #0ebb23 : #FF5252

plot(coppock, title="Coppock", linewidth=2, color=coppockColor)
hline(0, title="Zero Level", linestyle=hline.style_dotted)
