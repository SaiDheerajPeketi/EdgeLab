// EdgeLab v1 compatibility migration (2026-10-07): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/movings/double_exponential_moving_average.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Double Exponential Moving Average", shorttitle="DEMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
src = input.source(title="Source", defval=close)

dema(src, length) =>
	ema1 = ta.ema(src, length)
	ema2 = ta.ema(ema1, length)
	dema = 2 * ema1 - ema2

plot(dema(src, length), title="DEMA", linewidth=2, color=#6d1e7f)
