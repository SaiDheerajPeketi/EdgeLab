// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/movings/hull_moving_average.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Hull Moving Average", shorttitle="HMA", overlay=true)

length = input.int(title="Length", defval=14, minval=1)
src = input.source(title="Source", defval=close)

hma(src, length) =>
	ta.wma(2 * ta.wma(src, int(length / 2)) - ta.wma(src, length), int(math.round(math.sqrt(length))))

plot(hma(src, length), title="HMA", linewidth=2, color=#6d1e7f)
