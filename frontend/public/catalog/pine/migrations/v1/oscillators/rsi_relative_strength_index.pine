// Relative Strength Index (RSI) script may be freely distributed under the terms of GPL-3.0 license.
// EdgeLab v1 compatibility migration (2026-10-07): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/oscillators/rsi_relative_strength_index.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator(title="Relative Strength Index", shorttitle="RSI")

// Legacy transp ignored colors that already contained transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

length = input.int(title="Length", defval=14)
obLevel = input.int(title="Overbought Level", defval=70)
osLevel = input.int(title="Oversold Level", defval=30)
highlightBreakouts = input.bool(title="Highlight Overbought/Oversold Breakouts ?", defval=true)
srcInput = input.string(title="Source", defval="close",
	 options=["open",
				 "high",
				 "low",
				 "close",
				 "oo2",
				 "oh2",
				 "ol2",
				 "oc2",
				 "hh2",
				 "hl2",
				 "hc2",
				 "ll2",
				 "lc2",
				 "cc2",
				 "hlc3",
				 "ohlc4",
				 "wc",
				 "acc/dist",
				 "on balance volume",
				 "price volume trend"])

getBaseSource(input) =>
	src = 0.0
	if input == "open"
		src := open
	if input == "high"
		src := high
	if input == "low"
		src := low
	if input == "close"
		src := close
	if input == "oo2"
		src := (open + nz(open[1])) / 2
	if input == "oh2"
		src := (open + high) / 2
	if input == "ol2"
		src := (open + low) / 2
	if input == "oc2"
		src := (open + close) / 2
	if input == "hh2"
		src := (high + nz(high[1])) / 2
	if input == "hl2" // Median Price
		src := hl2
	if input == "hc2"
		src := (high + close) / 2
	if input == "ll2"
		src := (low + nz(low[1])) / 2
	if input == "lc2"
		src := (low + close) / 2
	if input == "cc2"
		src := (close + nz(close[1])) / 2
	if input == "hlc3" // Typical Price
		src := hlc3
	if input == "ohlc4"
		src := ohlc4
	if input == "wc" // Weighted Close
		src := (2 * close + high + low) / 4
	if input == "acc/dist"
		src := ta.accdist
	if input == "on balance volume"
		src := ta.cum(math.sign(ta.change(close)) * volume)
	if input == "price volume trend"
		src := ta.cum(ta.change(close) / close[1] * volume)
	src

src = getBaseSource(srcInput)

rsi = ta.rsi(src, length)

rsiColor = rsi > obLevel ? #0ebb23 : rsi < osLevel ? #FF5252 : #f4b77d
plot(rsi, title="RSI", linewidth=2, color=rsiColor)

transparent = color.new(#FFFFFF, 100)

maxLevelPlot = hline(100, title="Max Level", linestyle=hline.style_dotted, color=transparent)
obLevelPlot = hline(obLevel, title="Overbought Level", linestyle=hline.style_dotted)
hline(50, title="Middle Level", linestyle=hline.style_dotted)
osLevelPlot = hline(osLevel, title="Oversold Level", linestyle=hline.style_dotted)
minLevelPlot = hline(0, title="Min Level", linestyle=hline.style_dotted, color=transparent)
fill(obLevelPlot, osLevelPlot, color=_legacyTransparency(#9C27B0, 95))

obFillColor = rsi > obLevel and highlightBreakouts ? #4CAF50 : transparent
osFillColor = rsi < osLevel and highlightBreakouts ? #FF5252 : transparent

fill(maxLevelPlot, obLevelPlot, color=_legacyTransparency(obFillColor, 90))
fill(minLevelPlot, osLevelPlot, color=_legacyTransparency(osFillColor, 90))
