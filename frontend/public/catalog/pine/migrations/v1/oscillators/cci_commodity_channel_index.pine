//@version=5
// Copyright (c) 2019-present, Alex Orekhov (everget)
// Commodity Channel Index (CCI) script may be freely distributed under the terms of the GPL-3.0 license.
// EdgeLab v1 compatibility migration (2026-10-07): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/oscillators/cci_commodity_channel_index.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Commodity Channel Index", shorttitle="CCI")

// Legacy transp ignored colors that already contained transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

length = input.int(title="Length", defval=20)
obLevel = input.int(title="Overbought Level", defval=100)
osLevel = input.int(title="Oversold Level", defval=-100)
maxLevel = input.int(title="Max Level", defval=300)
minLevel = input.int(title="Min Level", defval=-300)
highlightBreakouts = input.bool(title="Highlight Breakouts ?", defval=true)
srcInput = input.string(title="Source", defval="hlc3",
	 options=["open",
				 "high",
				 "low",
				 "close",
				 "oo2",
				 "oh2",
				 "ol2",
				 "oc2",
				 "hh2",
				 "hl2",
				 "hc2",
				 "ll2",
				 "lc2",
				 "cc2",
				 "hlc3",
				 "ohlc4",
				 "wc",
				 "volume",
				 "acc/dist",
				 "on balance volume",
				 "price volume trend"])

getBaseSource(input) =>
	src = 0.0
	if input == "open"
		src := open
	if input == "high"
		src := high
	if input == "low"
		src := low
	if input == "close"
		src := close
	if input == "oo2"
		src := (open + nz(open[1])) / 2
	if input == "oh2"
		src := (open + high) / 2
	if input == "ol2"
		src := (open + low) / 2
	if input == "oc2"
		src := (open + close) / 2
	if input == "hh2"
		src := (high + nz(high[1])) / 2
	if input == "hl2" // Median Price
		src := hl2
	if input == "hc2"
		src := (high + close) / 2
	if input == "ll2"
		src := (low + nz(low[1])) / 2
	if input == "lc2"
		src := (low + close) / 2
	if input == "cc2"
		src := (close + nz(close[1])) / 2
	if input == "hlc3" // Typical Price
		src := hlc3
	if input == "ohlc4"
		src := ohlc4
	if input == "wc" // Weighted Close
		src := (2 * close + high + low) / 4
	if input == "volume"
		src := volume
	if input == "acc/dist"
		src := ta.accdist
	if input == "on balance volume"
		src := ta.cum(math.sign(ta.change(close)) * volume)
	if input == "price volume trend"
		src := ta.cum(ta.roc(src, 1) * volume)
	src

src = getBaseSource(srcInput)

cci = (src - ta.sma(src, length)) / (0.015 * ta.dev(src, length))

cciColor = cci > obLevel ? #0ebb23 : cci < osLevel ? #ff0000 : #f4b77d
plot(cci, title="CCI", linewidth=2, color=cciColor)

transparent = color.new(#FFFFFF, 100)

maxLevelPlot = hline(maxLevel, title="Max Level", linestyle=hline.style_dotted, color=transparent)
obLevelPlot = hline(obLevel, title="Overbought Level", linestyle=hline.style_dotted)
hline(0, title="Zero Level", linestyle=hline.style_dotted)
osLevelPlot = hline(osLevel, title="Oversold Level", linestyle=hline.style_dotted)
minLevelPlot = hline(minLevel, title="Min Level", linestyle=hline.style_dotted, color=transparent)

fill(obLevelPlot, osLevelPlot, color=_legacyTransparency(#9C27B0, 95))

obFillColor = cci > obLevel and highlightBreakouts ? #4CAF50 : transparent
osFillColor = cci < osLevel and highlightBreakouts ? #FF5252 : transparent

fill(maxLevelPlot, obLevelPlot, color=_legacyTransparency(obFillColor, 90))
fill(minLevelPlot, osLevelPlot, color=_legacyTransparency(osFillColor, 90))

co = ta.crossover(cci, obLevel)
cu = ta.crossunder(cci, osLevel)

alertcondition(co, title="Alert on CCI Overbought", message="CCI Overbought!")
alertcondition(cu, title="Alert on CCI Oversold", message="CCI Oversold!")
