// EdgeLab v1 compatibility migration (2026-10-07): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/oscillators/percentage_price_oscillator.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("Percentage Price Oscillator", shorttitle="PPO")

fastLength = input.int(title="Fast Length", minval=1, defval=12)
slowLength = input.int(title="Slow Length", minval=1, defval=26)
signalLength = input.int(title="Signal Length", minval=1, defval=9)
applyFilling = input.bool(title="Apply Filling ?", defval=false)
src = input.source(title="Source", defval=close)

ppo = 100 * (ta.ema(src, fastLength) - ta.ema(src, slowLength)) / ta.ema(src, slowLength)

signal = ta.ema(ppo, signalLength)

hist = ppo - signal

plot(hist, title="Histogram", style=plot.style_histogram, color=#ff006e)
ppoPlot = plot(ppo, title="PPO", color=#0094ff)
signalPlot = plot(signal, title="Signal", color=#ff6a00)

fillColor = applyFilling ? (ppo > signal ? #0ebb23 : #cc0000) : color.new(#FFFFFF, 100)
fill(ppoPlot, signalPlot, color=fillColor)
