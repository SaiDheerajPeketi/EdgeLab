// EdgeLab v1 compatibility migration (2026-10-07): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/oscillators/trix.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("TRIX")

// Legacy transp ignored colors that already contained transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

length = input.int(title="Length", defval=14)
mult = input.int(title="TRIX Value Multiplier", defval=1)
signalType = input.string(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Smoothing Length", defval=9)
src = input.source(title="Source", defval=close)
showSignal = input.bool(title="Show Signal Line ?", defval=true)
showHistogram = input.bool(title="Show Histogram ?", defval=false)
highlightCrossovers = input.bool(title="Highlight TRIX/Signal Crossovers ?", defval=true)
highlightZeroCrossovers = input.bool(title="Highlight Zero Line Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=false)

triple = ta.ema(ta.ema(ta.ema(src, length), length), length)

trix = mult * ta.roc(triple, 1)
signal = signalType == "SMA" ? ta.sma(trix, signalLength) : ta.ema(trix, signalLength)

hist = trix - signal
histColor = hist >= 0 ? (hist[1] < hist ? #26A69A : #B2DFDB) : (hist[1] < hist ? #FFCDD2 : #EF5350)
plot(showHistogram ? hist : na, title="Histogram", style=plot.style_columns, color=histColor)
hline(0, title="Zero Level", linestyle=hline.style_dotted)

trendColor = trix > signal ? #0ebb23 : #FF5252

trixColor = applyFilling ? trendColor : (trix > 0 ? #0ebb23 : #FF5252)
signalColor = applyFilling ? trendColor : #ff9800

trixPlot = plot(trix, title="TRIX", linewidth=2, color=trixColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color.new(#FFFFFF, 100)

fillColor = applyFilling ? trendColor : transparent
fill(trixPlot, signalPlot, color=_legacyTransparency(fillColor, 70))

zeroCrossBgColor = highlightZeroCrossovers ? (trix > 0 ? #4CAF50 : #FF5252) : transparent
bgcolor(_legacyTransparency(zeroCrossBgColor, 90))

plotshape(highlightCrossovers and ta.crossover(trix, signal) ? trix : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=#4CAF50)
plotshape(highlightCrossovers and ta.crossunder(trix, signal) ? trix : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=#FF5252)
