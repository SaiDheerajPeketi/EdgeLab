// EdgeLab v1 compatibility migration (2026-10-07): Pine v3 to v5.
// Derived from 0b164e1e4f2fb7b06524c6d0a26e6132228c9448/volume/on_balance_volume.pine; original retained unchanged.
// Changes and runtime limitations: ../README.md.
indicator("On Balance Volume", shorttitle="OBV", precision=0)

// Legacy transp ignored colors that already contained transparency.
_legacyTransparency(baseColor, amount) =>
    na(baseColor) ? na : color.t(baseColor) > 0 ? baseColor : color.new(baseColor, amount)

showSignal = input.bool(title="Show Signal ?", defval=true)
signalType = input.string(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Smoothing Length", defval=21)
highlightCrossovers = input.bool(title="Highlight Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)
src = input.source(title="Source", defval=close)

obv = ta.cum(math.sign(ta.change(src)) * volume)
signal = signalType == "EMA" ? ta.ema(obv, signalLength) : ta.sma(obv, signalLength)

trendColor = obv > signal ? #0ebb23 : #FF5252

obvColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

obvPlot = plot(obv, title="OBV", linewidth=2, color=obvColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color.new(#FFFFFF, 100)

fillColor = applyFilling ? trendColor : transparent
fill(obvPlot, signalPlot, color=_legacyTransparency(fillColor, 70))

plotshape(ta.crossover(obv, signal) and highlightCrossovers ? obv : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=#4CAF50)
plotshape(ta.crossunder(obv, signal) and highlightCrossovers ? obv : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=#FF5252)
