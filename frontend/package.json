    "three": "0.186.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
