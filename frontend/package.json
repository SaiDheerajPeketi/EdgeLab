  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --force",
    "build": "npm run check:pine-engine && node ../scripts/source-release.mjs && tsc -b && vite build",
    "check:pine-engine": "node ../scripts/pine-engine.mjs",
    "postbuild": "node ../scripts/source-release.mjs --verify",
    "preview": "vite preview --host 127.0.0.1",
    "quality:ui": "node ../scripts/check-ui-surface-inventory.mjs && node ../scripts/check-ui-release.mjs && node ../scripts/check-ui-performance.mjs && node ../scripts/check-ui-motion.mjs"
  },
  "dependencies": {
