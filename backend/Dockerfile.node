FROM node:22-slim

ENV NODE_ENV=production \
    PORT=3001 \
    LEGACY_API_MAX_BODY_BYTES=10485760 \
    LEGACY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

WORKDIR /app

RUN mkdir -p /app/backend/data /app/backend/uploads

COPY backend /app/backend

EXPOSE 3001

CMD ["node", "backend/index.js"]
