FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend \
    EDGELAB_API_TOKEN= \
    EDGELAB_API_WORKERS= \
    EDGELAB_API_TIMEOUT_SECONDS=120 \
    EDGELAB_API_GRACEFUL_TIMEOUT_SECONDS=30 \
    EDGELAB_API_KEEPALIVE_SECONDS=5 \
    EDGELAB_DB_POOL_SIZE=5 \
    EDGELAB_DB_POOL_MAX_OVERFLOW=10 \
    EDGELAB_DB_POOL_TIMEOUT_SECONDS=5 \
    EDGELAB_HTTP_REQUEST_LIMIT=0 \
    EDGELAB_DB_CONNECT_TIMEOUT_SECONDS=10 \
    EDGELAB_HTTP_QUEUE_WAIT_SECONDS=0.25 \
    EDGELAB_HTTP_QUEUE_DEPTH=0 \
    EDGELAB_HTTP_PROBE_BUDGET=2 \
    EDGELAB_HTTP_VALIDATION_THREAD_RESERVE=8 \
    EDGELAB_HTTP_SQL_CHECKOUT_MULTIPLIER=2 \
    EDGELAB_DB_POOL_RECYCLE_SECONDS=1800 \
    EDGELAB_DB_SQLITE_LOCK_TIMEOUT_SECONDS=60 \
    EDGELAB_MIGRATION_MAX_ATTEMPTS=12 \
    EDGELAB_MIGRATION_RETRY_SECONDS=5 \
    EDGELAB_METRICS_BASE_DIR=/tmp \
    EDGELAB_METRICS_ENABLED=1 \
    EDGELAB_HTTP_LOG_SAMPLE_RATIO=0.1 \
    EDGELAB_HTTP_SLOW_REQUEST_SECONDS=1 \
    EDGELAB_OTEL_MAX_QUEUE_SIZE=2048 \
    EDGELAB_OTEL_MAX_BATCH_SIZE=512 \
    EDGELAB_OTEL_SCHEDULE_DELAY_MS=5000 \
    EDGELAB_OTEL_SHUTDOWN_TIMEOUT_SECONDS=5 \
    EDGELAB_OTEL_EXPORT_TIMEOUT_SECONDS=5 \
    EDGELAB_MEMORY_CACHE_MAX_ENTRIES=256 \
    EDGELAB_REDIS_INVALIDATION_BATCH_SIZE=256 \
    EDGELAB_REDIS_CACHE_TIMEOUT_SECONDS=0.25 \
    EDGELAB_CACHE_FAILURE_LOG_INTERVAL_SECONDS=30 \
    EDGELAB_RUN_MIGRATIONS=1 \
    EDGELAB_JWT_SECRET= \
    EDGELAB_AUTH_PROVIDER=better-auth \
    EDGELAB_BETTER_AUTH_INTERNAL_URL=http://auth:3002 \
    EDGELAB_AUTH_SERVICE_KEY= \
    EDGELAB_DEPLOYMENT_MODE=production \
    EDGELAB_BILLING_ENABLED=0 \
    EDGELAB_STRIPE_MODE=test \
    EDGELAB_DATASETS_ROOT=/datasets \
    EDGELAB_MAX_APP_DATA_ROWS=100000 \
    EDGELAB_MAX_REQUEST_BODY_BYTES=26214400 \
    EDGELAB_MARKET_DATA_IMPORT_ENABLED=1 \
    EDGELAB_MARKET_DATA_DATABASE_URL= \
    POSTGRES_DB=edgelab \
    POSTGRES_USER=edgelab \
    POSTGRES_PASSWORD=edgelab \
    EDGELAB_POSTGRES_HOST=pgbouncer-postgres \
    EDGELAB_POSTGRES_CONNECT_PORT=6432

WORKDIR /app

RUN addgroup --system edgelab \
    && adduser --system --ingroup edgelab edgelab \
    && mkdir -p /datasets /var/lib/edgelab \
    && chown -R edgelab:edgelab /var/lib/edgelab

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend /app/backend

USER edgelab
EXPOSE 8000

CMD ["sh", "/app/backend/scripts/start_api.sh"]
