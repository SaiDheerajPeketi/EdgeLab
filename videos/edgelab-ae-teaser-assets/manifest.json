{
  "name": "EdgeLab AE Teaser Editable Components",
  "version": "0.3.0",
  "source": "AE-editable SVG primitives and native shape/text layer definitions based on EdgeLab app surfaces",
  "dimensions": {
    "width": 3840,
    "height": 2160,
    "label": "4K UHD"
  },
  "fps": 30,
  "duration_seconds": 7,
  "excluded": [
    "Marketing hero / product overview",
    "Sign-in / beta access screens",
    "videos/edgelab-beta-launch",
    "HTML foreignObject captures"
  ],
  "outputs": {
    "svg": "svg/{component-scene-id}.svg",
    "preview": "preview/{component-scene-id}.png",
    "after_effects_script": "ae/edgelab-teaser-assets.jsx"
  },
  "colors": {
    "bg": "#05070a",
    "bg2": "#071018",
    "panel": "#08111b",
    "panel2": "#0b1622",
    "panel3": "#0d1f2a",
    "stroke": "#1f3343",
    "stroke2": "#294353",
    "text": "#f8fbff",
    "muted": "#8b9bb0",
    "subtext": "#b8c7d9",
    "cyan": "#67e8f9",
    "cyan2": "#22d3ee",
    "green": "#34d399",
    "red": "#fb7185",
    "amber": "#fbbf24",
    "blue": "#60a5fa",
    "violet": "#a78bfa"
  },
  "fonts": [
    "Inter",
    "Syne",
    "JetBrains Mono"
  ],
  "editing_notes": [
    "SVG files contain primitive rect, text, circle, line, and path elements only.",
    "The JSX creates native After Effects shape and text layers for the same logical layer list.",
    "Chart candles, tables, badges, metric cards, panels, and labels are separate logical layers where practical."
  ],
  "scenes": [
    {
      "id": "session-gateway",
      "title": "Session gateway",
      "short_title": "Setup surface",
      "width": 3840,
      "height": 2160,
      "import_order": 1,
      "svg": "svg/session-gateway.svg",
      "preview": "preview/session-gateway.png",
      "layer_count": 78,
      "layer_roles": [
        "background",
        "background-accent",
        "badge",
        "badge-text",
        "chart-background",
        "chart-grid",
        "chart-line",
        "chart-marker",
        "label",
        "metadata",
        "metric-label",
        "metric-value",
        "panel",
        "panel-title",
        "primary-value",
        "subtitle",
        "table-row",
        "table-text",
        "title"
      ],
      "suggested_animation_handles": [
        {
          "role": "panel",
          "timing": "0:00-0:18",
          "motion": "fade/scale panels on as grouped blocks"
        },
        {
          "role": "panel-title",
          "timing": "0:10-0:24",
          "motion": "text reveal after parent panel"
        },
        {
          "role": "chart-line/candle-body",
          "timing": "0:18-0:45",
          "motion": "draw chart paths or cascade candle bodies left to right"
        },
        {
          "role": "metric-value",
          "timing": "0:32-0:55",
          "motion": "count values up with short opacity pop"
        },
        {
          "role": "table-row",
          "timing": "0:24-0:50",
          "motion": "stagger rows by 2 frames"
        }
      ]
    },
